# For bind mounts, use the UID/GID from id <username> for a DSM account
# with explicit read/write ACL access to the data directory. See README.md.
# The default Docker-managed volume uses 1000:1000.
BRIDGE_UID=1000
BRIDGE_GID=1000
TZ=America/Denver

# Leave unset for a Docker-managed volume; set to ./data for repo-local storage.
# BRIDGE_DATA_SOURCE=./data

# Optional: retain an existing Docker volume name when upgrading.
# Used only when BRIDGE_DATA_SOURCE is unset.
# BRIDGE_VOLUME_NAME=synolistbridge_data

# After delivery to AnyList: false checks off the Keep item; true deletes it.
BRIDGE_DELETE_KEEP_ITEMS=false

# Poll interval: whole number plus s, m, h, or d; minimum 30s, maximum 7d.
# Unset or empty uses config.json's poll_seconds, defaulting to 60 (1m).
BRIDGE_POLL_INTERVAL=1m

# Reuse categories from matching AnyList list items and favorites.
BRIDGE_CATEGORY_MATCHING=true

# Refresh the SQLite category cache; same duration syntax/range as polling.
BRIDGE_CATEGORY_REFRESH_INTERVAL=7d
